# ──────────────────────────────────────────────────────────────────────
# CONFIGURACIÓN DEL ENTORNO - TechFlow
# Copiar este archivo como .env para configurar el entorno de producción/desarrollo.
# ──────────────────────────────────────────────────────────────────────

# Clave secreta para firmar sesiones de Flask (CRÍTICO: cambiar en producción)
SECRET_KEY=dev-secret-key-CAMBIAR-en-produccion-segura-12345

# URL de la base de datos (PostgreSQL para producción, SQLite por defecto para desarrollo)
# SQLite fallback: sqlite:///instance/techflow.db
DATABASE_URL=sqlite:///techflow.db
# Para PostgreSQL: postgresql://usuario:contraseña@localhost:5432/techflow

# URL de Redis (Requerido solo si se utiliza Celery para tareas en segundo plano)
# Si no se define, el sistema usará un fallback automático basado en hilos de Python.
REDIS_URL=redis://localhost:6379/0

# Sembrado automático de base de datos con datos reales de prueba (clientes, equipos, órdenes, etc.)
# Opciones: true | 1 (solo se aplica si la base de datos está vacía)
SEED_DB=true
